# Workbooks in the project root are working copies and generated lists (Missing_Fabric_Data.xlsx, SKUs_Without_Fabric_Data.*).
# The copies the tool ingests live in data/raw/ and are committed, together with the cleaned store, so a hosted deploy
# carries the whole dataset without the duplicates.
/*.xlsx
/*.txt

# The cleaned parquet store under data/store/ IS committed, so the deployed app ships with
# exactly the dataset it reads locally. Only the rebuildable cache inside it is ignored.
data/store/*.building

__pycache__/
.streamlit/secrets.toml
.env


# Python virtual environments
.venv/
venv/

# Python cache files
*.pyc

# Local databases
*.db
# Sensitive configuration
.env.*
!.env.example